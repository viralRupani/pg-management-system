# Caddy config for Basera — automatic HTTPS (Let's Encrypt, auto-renew) +
# reverse-proxy for the API + static hosting for the two web frontends.
#
# Install:
#   sudo apt install caddy            # see docs/PRODUCTION.md for the repo setup
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   # replace the 3 domains + email below with yours
#   sudo systemctl reload caddy
#   sudo journalctl -u caddy -f
#
# Caddy listens on 80/443 (the only public ports). It obtains + renews certs on
# its own — no certbot, no cron. Point each subdomain's DNS A record at this box
# BEFORE reloading (Caddy needs to answer the ACME challenge).

{
	# Email for Let's Encrypt expiry notices. Replace with yours.
	email admin@basera.app
}

# ---- API ----------------------------------------------------------------------
api.basera.app {
	reverse_proxy 127.0.0.1:4000
	encode gzip

	# The API sets its own CORS (from CORS_ORIGINS); these are transport headers.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# ---- Admin dashboard (static export → apps/admin/out) --------------------------
admin.basera.app {
	root * /var/www/admin
	file_server
	encode gzip
	# Static export uses trailingSlash:true (/foo → /foo/index.html); try_files
	# resolves clean URLs to the exported directory index.
	try_files {path} {path}/ /index.html

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}
}

# ---- Resident web app / PWA (static export → apps/resident-web/out) ------------
app.basera.app {
	root * /var/www/resident
	file_server
	encode gzip
	try_files {path} {path}/ /index.html

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}
}

# ---- (Optional) landing site on the root domain -------------------------------
# The marketing site (apps/landing, Vite → dist/) has its own S3+CloudFront
# runbook in apps/landing/DEPLOY.md. To instead serve it from this box, uncomment:
#
# basera.app, www.basera.app {
# 	root * /var/www/landing
# 	file_server
# 	encode gzip
# }
