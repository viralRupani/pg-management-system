# ==============================================================================
# Basera API — PRODUCTION environment.
#
# Install to /etc/basera/api.env, chmod 600, owned by the `basera` service user.
# The systemd unit loads it via EnvironmentFile (prod `node dist/main.js` does NOT
# read a .env file itself). This file is SECRET — never commit it; keep a copy in
# a password manager (losing it = regenerated JWT secrets = all sessions logged out).
#
# Values are validated at boot (apps/api/src/config/env.ts) — the API refuses to
# start if anything required is missing or malformed. Generate every secret:
#     openssl rand -hex 32
# ==============================================================================

NODE_ENV=production
PORT=4000

# --- CORS ----------------------------------------------------------------------
# EXACT origins of the web frontends (comma-separated, no trailing slash). The
# browser blocks the admin/resident apps if these don't match precisely.
CORS_ORIGINS=https://admin.basera.app,https://app.basera.app

# --- Database (the RLS role split — 3 URLs) ------------------------------------
# app_user  = NOBYPASSRLS (every tenant request; the workhorse connection)
# platform_user = BYPASSRLS (platform/metering module only)
# postgres  = superuser (migrations only)
# On the single box these point at the local container (127.0.0.1:5432). When you
# split the DB onto its own server (Phase 2), ONLY these three URLs change.
#
# HARDENING: infra/init-db.sql creates app_user/platform_user with default
# passwords. After first DB init, change them (ALTER ROLE ... PASSWORD ...) and put
# the new ones here — see docs/PRODUCTION.md.
DATABASE_URL=postgres://app_user:CHANGE_ME_APP@127.0.0.1:5432/pg_management
PLATFORM_DATABASE_URL=postgres://platform_user:CHANGE_ME_PLATFORM@127.0.0.1:5432/pg_management
MIGRATION_DATABASE_URL=postgres://postgres:CHANGE_ME_SUPERUSER@127.0.0.1:5432/pg_management
# Max connections in the app pool (per API instance). 10 is fine to start.
DB_POOL_MAX=10

# --- Redis ---------------------------------------------------------------------
# OTP storage + BullMQ job queue. Local container now; change ONLY this when you
# split Redis onto its own server (Phase 2).
REDIS_URL=redis://127.0.0.1:6379

# --- JWT (REQUIRED — generate both with `openssl rand -hex 32`) -----------------
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_openssl_rand_hex_32
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=30d

# --- Password reset ------------------------------------------------------------
# Base URL of the ADMIN web app — password-reset links point here.
APP_BASE_URL=https://admin.basera.app
PWRESET_TTL_SECONDS=900

# --- OTP TTLs ------------------------------------------------------------------
OTP_TTL_SECONDS=300          # phone/SMS OTP (needs a real SMS driver — see guide)
EMAIL_OTP_TTL_SECONDS=600    # resident email-verification OTP
# NOTE: OTP_DEV_LOG / OTP_DEV_FIXED_CODE are FORCE-DISABLED under NODE_ENV=production
# — do not rely on them; they cannot leak codes in prod.

# --- File storage (S3) — REQUIRED for uploads to work --------------------------
# `local` is a non-functional stub. Production MUST use s3, or KYC docs / payment
# screenshots / complaint photos / logos silently fail. Files upload direct to S3
# (never touch this server's disk). Bucket must be PRIVATE with CORS for the
# admin + app origins (see guide).
STORAGE_DRIVER=s3
S3_REGION=ap-south-1
S3_BUCKET=basera-uploads
# IAM key — also reused by SES below. Needs s3:PutObject + s3:GetObject on the
# bucket, and ses:SendEmail. NOT prefixed S3_.
ACCESS_KEY_ID=CHANGE_ME
SECRET_ACCESS_KEY=CHANGE_ME
# S3_PRESIGN_TTL_SECONDS=300
# S3_KYC_DOWNLOAD_TTL_SECONDS=120
# UPLOAD_MAX_BYTES=5242880

# --- Outbound email (AWS SES) --------------------------------------------------
# Setting SES_FROM_EMAIL flips email from console-stub to REAL sends. Required for:
# manager password reset, resident email-verification OTP, and resident
# notification emails (the interim channel until push). Reuses the S3 creds above;
# needs ses:SendEmail + a verified domain identity (DKIM/SPF/DMARC) out of the SES
# sandbox. SES_REGION falls back to S3_REGION if unset.
SES_FROM_EMAIL=no-reply@basera.app
SES_REGION=ap-south-1
MAIL_FROM_NAME=Basera
# MAIL_REPLY_TO=support@basera.app
